PORT=8080
CORS_ORIGIN=http://localhost:5173

# Local PostgreSQL development. Cloud Run uses the Cloud SQL variables below.
DATABASE_URL=postgresql://postgres:password@localhost:5432/clinical_app
DATABASE_SSL=false

# Cloud Run / Cloud SQL
INSTANCE_CONNECTION_NAME=project-id:us-east1:clinical-db
DB_USER=clinical_user
DB_PASSWORD=replace-me
DB_NAME=clinical_app
DB_POOL_SIZE=5

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-me
JWT_SECRET=replace-with-a-long-random-value
GEMINI_API_KEY=replace-me
GEMINI_MODEL=gemini-3.8-flash

# Resend account-status notifications
RESEND_API_KEY=re_replace_me
RESEND_FROM=Clinical System <onboarding@resend.dev>
RESEND_REPLY_TO=clinicalsystemadmin@gmail.com
